[Unit]
Description=极简个税 PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/www/wwwroot/jijian-geshui/current
EnvironmentFile=/www/wwwroot/jijian-geshui/shared/.env.production
Environment=BACKUP_DIR=/var/backups/jijian-geshui
Environment=BACKUP_RETENTION_DAYS=15
ExecStart=/usr/bin/node /www/wwwroot/jijian-geshui/current/ops/backup-db.mjs
