# 数据库配置
# PostgreSQL 数据库连接地址。
DATABASE_URI=postgres://postgres:postgres@localhost:5432/jijian_geshui
# 城市社保、公积金规则的服务端缓存秒数，默认 300；设置为 0 可关闭缓存。
CITY_RULE_CACHE_SECONDS=300

# 安全密钥配置
# 用于 Payload 加密和签名的主密钥，生产环境请替换为足够长的随机字符串。
PAYLOAD_SECRET=replace-with-a-long-random-string
# 用于预览模式的独立密钥，请勿与主密钥复用。
PAYLOAD_PREVIEW_SECRET=replace-with-a-separate-preview-secret

# 站点配置
# 应用对外访问地址，用于生成绝对 URL 和服务端回调地址。
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# 数据分析配置
# Google Tag Manager 容器 ID；不使用时留空。
NEXT_PUBLIC_GTM_ID=
# Plausible Analytics 统计域名；不使用时留空。
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
